*.obj
*.elf
*.bin
*.hex
*.objdump
*.map
# --- Backup Files ---
*~.bak
*.backup
# --- Temporary Files ---
*.tmp
*.temp
# --- Arduino Secrets (Ignore your secrets file) ---
src/arduino_secrets.h   